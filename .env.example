# Copy this file to .env only if you need to override a default.
# The application reads .env from the repository root. Defaults live in
# backend/app/config.py; every value below is optional for local use.
# All paths below are examples; when set, prefer absolute paths.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Defaults: <repo>/data and <repo>/models. Audio, SQLite, score matrices and
# evidence stay under the data directory. Model weights stay under models.
# A hosted instance must point both at its persistent disk, for example:
# SILENCE_DATA_DIR=/var/data
# SILENCE_MODEL_DIR=/var/data/models
# SILENCE_DATABASE_PATH=C:\Users\you\SilenceArchive\data\silence_archive.sqlite3
# SILENCE_YAMNET_WEIGHTS_PATH=C:\Users\you\SilenceArchive\models\yamnet\yamnet.h5
# Set this to true on a hosted deployment so /api/health reports local_only=false.
# SILENCE_HOSTED=true

# ---------------------------------------------------------------------------
# Intake limits
# ---------------------------------------------------------------------------
SILENCE_MAX_UPLOAD_MB=80
SILENCE_MAX_DURATION_SECONDS=180
SILENCE_MIN_DURATION_SECONDS=1
SILENCE_MAX_SAMPLE_RATE=96000
SILENCE_MAX_CHANNELS=8

# ---------------------------------------------------------------------------
# Comparison defaults
# ---------------------------------------------------------------------------
SILENCE_DEFAULT_SCORE_THRESHOLD=0.20
SILENCE_DEFAULT_FADING_THRESHOLD_PP=10

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API
# ---------------------------------------------------------------------------
# Comma-separated exact origins. No wildcard is used. Local development uses
# the Vite proxy, so the defaults below are enough. A hosted frontend must add
# its exact production origin, and any deliberate preview origin, one by one:
# SILENCE_CORS_ORIGINS=https://hush-atlas.vercel.app
SILENCE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://127.0.0.1:5173,https://localhost:5173

# ---------------------------------------------------------------------------
# Development-only fallback: local Gemma through Ollama
# ---------------------------------------------------------------------------
# The shipped reflection interface uses Gemma 2 2B in the browser through
# WebLLM. This loopback endpoint is a development fallback for the server-side
# reflection route; it is not the on-device AI feature and is never used by the
# deployed frontend. No cloud LLM endpoint or API key is accepted.
SILENCE_OLLAMA_URL=http://127.0.0.1:11434
# Leave empty to use the newest installed compatible Gemma model automatically,
# or pin one that is already installed locally.
# SILENCE_OLLAMA_MODEL=gemma3:4b
SILENCE_OLLAMA_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Analysis
# ---------------------------------------------------------------------------
SILENCE_ANALYSIS_WORKERS=1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The frontend is configured at build time with frontend/.env.example
# (VITE_API_BASE_URL). Do not put secrets in any VITE_* value: Vite embeds
# those values in the public browser bundle.
