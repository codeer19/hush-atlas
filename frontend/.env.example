# Leave this empty for local development. Vite proxies /api to the local
# FastAPI server, so the browser only talks to the Vite HTTPS origin.
#
# In production, set the Render service origin. The app appends /api if it is
# not already present, so both of these are valid:
#   https://hush-atlas-api.onrender.com
#   https://hush-atlas-api.onrender.com/api
#
# This value is public. Never put a secret or API key in a VITE_* variable.
VITE_API_BASE_URL=
